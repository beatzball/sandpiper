{
  "name": "@beatzball/sandpiper",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript client for the sandpiper host API",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:integration": "npm run build && node --test scripts/integration.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "typescript": "5.9.3"
  }
}
